    "# 1. Load Dataset\n",
    "df = pd.read_csv('oil_sales_assignment_dataset.csv')\n",
    "\n",
    "# 2. Encode Categorical Variables\n",
    "categorical_cols = ['city', 'store_name', 'manufacturer', 'brand', 'class', 'size', 'sku', 'price_bracket']\n",
    "for col in categorical_cols:\n",
